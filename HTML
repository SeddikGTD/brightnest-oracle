<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <title>BrightNest Oracle (Local)</title>
    <style>
        body { background: #0c0b1a; color: #fff; font-family: sans-serif; padding: 20px; text-align: center; }
        .signal-card { border: 1px solid #4e4e6a; padding: 15px; margin: 10px auto; border-radius: 10px; max-width: 350px; background: #1a1a2e; }
        #status { margin-bottom: 10px; color: #bdbdbd; }
    </style>
</head>
<body>
    <h1>إشارات التداول - تجربة محلية</h1>
    <div id="status">جاري الاتصال بالخادم...</div>
    <div id="signals-container">جاري التحميل...</div>

    <script>
        async function fetchSignals() {
            const status = document.getElementById('status');
            const container = document.getElementById('signals-container');
            try {
                const res = await fetch('/api/signals');
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const payload = await res.json();
                const data = payload.data || payload; // تقبل الشكل {ok:true,data:...} أو مصفوفة مباشرة
                status.textContent = 'آخر تحديث: ' + new Date().toLocaleTimeString();
                if (!data || data.length === 0) {
                    container.innerHTML = "لا توجد إشارات حالياً.";
                    return;
                }
                container.innerHTML = '';
                data.slice().reverse().forEach(s => {
                    container.innerHTML += `
                        <div class="signal-card">
                            <h3>الزوج: ${s.asset_pair || s.asset || 'غير محدد'}</h3>
                            <p>الاتجاه: ${s.action || s.direction || 'غير محدد'}</p>
                            <p>الثقة: ${s.signal_strength ?? s.confidence ?? 0}%</p>
                            <p style="font-size:0.85em;color:#9aa;">${s.created_at ? new Date(s.created_at).toLocaleString() : (s.time || '')}</p>
                        </div>`;
                });
            } catch (err) {
                status.textContent = 'خطأ في الاتصال: ' + err.message;
                container.innerHTML = '';
            }
        }

        // تحديث فورياً ثم تكرار كل 3 ثوانٍ
        fetchSignals();
        setInterval(fetchSignals, 3000);
    </script>
</body>
</html>
